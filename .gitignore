# Node.js dependencies
node_modules/

# Java build directories
target/

# Exclude Maven wrapper jar
!.mvn/wrapper/maven-wrapper.jar

# Exclude build folders within src
!**/src/main/**/target/
!**/src/test/**/target/

# STS (Spring Tool Suite) IDE files
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache

# IntelliJ IDEA files
.idea/
*.iws
*.iml
*.ipr

# NetBeans IDE files
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/
/build/
!**/src/main/**/build/
!**/src/test/**/build/

# VS Code settings
.vscode/

# Log files
*.log

# OS generated files
.DS_Store
Thumbs.db

# Help markdown file (if not part of the source code)
HELP.md
